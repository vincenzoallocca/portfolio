{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-bump",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // Stesso sito del portfolio (vincenzoallocca.dev): il cookie del dispositivo è first-party.
  // Custom Domain: Cloudflare crea da sé il record DNS e il certificato.
  "routes": [{ "pattern": "bump.vincenzoallocca.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-bump",
      "database_id": "e05bd329-1462-41b3-ad0f-76cf85a2d43c",
      "migrations_dir": "migrations"
    }
  ],

  // Niente cron: il piano Free ha 5 trigger per account, già usati da haste.it.
  // La pulizia (IP/User-Agent hashati oltre 30 giorni, contatori scaduti) gira su ogni richiesta.

  // BUMP_SECRET è un segreto: `npx wrangler secret put BUMP_SECRET`.
  "vars": { "ALLOWED_ORIGINS": "https://vincenzoallocca.dev" },

  "observability": { "enabled": true }
}
